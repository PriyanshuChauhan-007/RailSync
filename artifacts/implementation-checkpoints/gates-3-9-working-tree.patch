+    assert "INVALID_EXECUTION_SNAPSHOT" in missing.json()["detail"]["message"]
+    started = client.post(f"/api/plans/{plan_id}/blocks/{block['block_id']}/status", json={
+        "target_status": "IN_PROGRESS", "execution": {
